# Google Cloud Console -> enable YouTube Data API v3 -> Credentials -> API key
YOUTUBE_API_KEY=
# Soft daily cap in quota units (YouTube default is 10000)
YT_DAILY_LIMIT=9000

# OpenAI powers the in-app intelligence / idea-generation layer.
# Get a key from the OpenAI API dashboard.
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna.
OPENAI_MODEL=gpt-6-luna

# Gemini watches public YouTube videos directly for structured content understanding.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
